{{ ansible_managed | comment }}

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_stage1_dir }}/shared/logs/api/implant_logs/legacy_text/*.log"
  multiline.pattern: '^\d\d\d\d\-\d\d\-\d\d\s\d\d\:\d\d\:\d\d\sUTC\s'
  multiline.negate: true
  multiline.match: after
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: stage1
      log:
        type: implant
