- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - {{ (redelk_cobaltstrike_dir ~ '/server/data/export_credentials.tsv') | to_json }}
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
