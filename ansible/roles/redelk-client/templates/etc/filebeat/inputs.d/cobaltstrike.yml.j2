{{ ansible_managed | comment }}

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - {{ (redelk_cobaltstrike_dir ~ '/server/logs/*/events.log') | to_json }}
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: events

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - {{ (redelk_cobaltstrike_dir ~ '/server/logs/*/weblog*') | to_json }}
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
