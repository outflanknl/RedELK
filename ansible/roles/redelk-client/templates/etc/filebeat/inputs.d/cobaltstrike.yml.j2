{{ ansible_managed | comment }}

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/events.log"
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: events

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/weblog*"
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: weblog

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/downloads.log"
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: downloads

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/data/export_credentials.tsv"
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: credentials

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/*/beacon_*.log"
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/*/ssh_*.log"
  multiline.pattern: '(^\d\d\/\d\d\s\d\d\:\d\d\:\d\d\sUTC\s\[)|(^\d\d\/\d\d\s\d\d\:\d\d\:\d\d\s\[)'
  multiline.negate: true
  multiline.match: after
  multiline.max_lines: 100000
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: beacon

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/*/keystrokes/keystrokes_*.txt"
  multiline.pattern: '(^\d\d\/\d\d\s\d\d\:\d\d\:\d\d\sUTC\s\[)|(^\d\d\/\d\d\s\d\d\:\d\d\:\d\d\s\[)'
  multiline.negate: true
  multiline.match: after
  multiline.max_lines: 100000
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: keystrokes

- type: log
  scan_frequency: 5s
  enabled: true
  fields_under_root: true
  paths:
    - "{{ redelk_cobaltstrike_dir }}/server/logs/*/*/screenshots.log"
  multiline.pattern: '(^\d\d\/\d\d\s\d\d\:\d\d\:\d\d\sUTC\s\[)|(^\d\d\/\d\d\s\d\d\:\d\d\:\d\d\s\[)'
  multiline.negate: true
  multiline.match: after
  multiline.max_lines: 100000
  fields:
    infra:
      attack_scenario: {{ redelk_attack_scenario }}
      log:
        type: rtops
    c2:
      program: cobaltstrike
      log:
        type: screenshots
