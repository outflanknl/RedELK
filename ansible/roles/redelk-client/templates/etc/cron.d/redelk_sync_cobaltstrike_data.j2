{{ ansible_managed | comment }}

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

{% for source in ['server/logs', 'profiles', 'server/data'] %}
* * * * * root if [ -d {{ (redelk_cobaltstrike_dir ~ '/' ~ source) | quote }} ]; then /usr/bin/rsync -rvx --append-verify --delete -- {{ (redelk_cobaltstrike_dir ~ '/' ~ source) | quote }} {{ (redelk_sync_user_home ~ '/cobaltstrike/') | quote }} && /bin/chown -R -- {{ (redelk_sync_user ~ ':' ~ redelk_sync_user) | quote }} {{ (redelk_sync_user_home ~ '/cobaltstrike/') | quote }}; fi
{% endfor %}
* * * * * root {{ (redelk_bin_dir ~ '/export_cobaltstrikedata.sh') | quote }}
* * * * * root {{ (redelk_bin_dir ~ '/copydownloads_cobaltstrike.sh') | quote }}
