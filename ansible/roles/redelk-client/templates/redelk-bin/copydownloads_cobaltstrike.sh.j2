#!/bin/sh
# Copy Cobalt Strike downloads into the dedicated RedELK sync home.

LOGFILE={{ (redelk_log_dir ~ '/copydownloads.log') | quote }}
CSDIR={{ (redelk_cobaltstrike_dir ~ '/server') | quote }}
DESTDIR={{ (redelk_sync_user_home ~ '/cobaltstrike/downloads') | quote }}

[ -d "$CSDIR/downloads" ] || exit 0
mkdir -p "$DESTDIR" >> "$LOGFILE" 2>&1 || exit 1

echo "$(date) # Start CS downloads copy" >> "$LOGFILE" 2>&1

for fileid in $(ls "$CSDIR/downloads/" | grep -v '\.'); do
  orifilename=$(grep -rn -- "$fileid" "$CSDIR"/logs/*/downloads.log | awk 'BEGIN {FS="\t"}; {print $6}')
  if [ -z "$orifilename" ]; then
    orifilename="filenameunknown"
  fi
  if [ ! -f "$DESTDIR/${fileid}_${orifilename}" ]; then
    cp -- "$CSDIR/downloads/${fileid}" "$DESTDIR/${fileid}_${orifilename}" || exit 1
    chown -- {{ (redelk_sync_user ~ ':' ~ redelk_sync_user) | quote }} "$DESTDIR/${fileid}_${orifilename}" || exit 1
  fi
done

echo "$(date) # Done CS" >> "$LOGFILE" 2>&1
