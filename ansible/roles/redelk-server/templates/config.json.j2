{
  "loglevel": {{ redelk_loglevel | to_json }},
  "interval": {{ redelk_alarm_interval }},
  "tempDir": {{ redelk_alarm_temp_dir | to_json }},
  "redelkserver_letsencrypt": {
    "enable_letsencrypt": {{ redelk_letsencrypt_enabled | ternary('true', 'false') }},
    "external_domain": {{ redelk_external_domain | to_json }},
    "le_email": {{ redelk_letsencrypt_email | to_json }},
    "staging": {{ redelk_letsencrypt_staging | to_json }}
  },
  "project_name": "redelk-project",
  "es_connection": [
    "https://elastic:{{ redelk_server_elastic_password | urlencode | replace('/', '%2F') }}@redelk-elasticsearch:9200"
  ],
  "notifications": {
    "email": {
      "enabled": false,
      "smtp": {
        "host": "localhost",
        "port": 25,
        "login": "redelk@example.com",
        "pass": "redelk"
      },
      "from": "redelk@example.com",
      "to": [
        "redelk@example.com"
      ]
    },
    "msteams": {
      "enabled": false,
      "webhook_url": "INSERT_MSTEAMS_WEBHOOK_URL_HERE"
    },
    "slack": {
      "enabled": false,
      "webhook_url": "INSERT_SLACK_WEBHOOK_URL_HERE"
    }
  },
  "alarms": {
    "alarm_dummy": {
      "enabled": false
    },
    "alarm_filehash": {
      "enabled": true,
      "interval": 300,
      "vt_api_key": "",
      "ibm_basic_auth": "Basic ",
      "ha_api_key": ""
    },
    "alarm_httptraffic": {
      "enabled": true,
      "interval": 310
    },
    "alarm_useragent": {
      "enabled": true,
      "interval": 320
    },
    "alarm_backendalarm": {
      "enabled": true,
      "interval": 320
    },
    "alarm_manual": {
      "enabled": false,
      "interval": 300
    }
  },
  "enrich": {
    "enrich_csbeacon": {
      "enabled": true,
      "interval": 300
    },
    "enrich_stage1": {
      "enabled": true,
      "interval": 300
    },
    "enrich_sliver": {
      "enabled": true,
      "interval": 300
    },
    "enrich_greynoise": {
      "enabled": true,
      "interval": 310,
      "cache": 86400,
      "api_key": ""
    },
    "enrich_tor": {
      "enabled": true,
      "interval": 360,
      "cache": 360
    },
    "enrich_iplists": {
      "enabled": true,
      "interval": 30
    },
    "enrich_synciplists": {
      "enabled": true,
      "interval": 360
    },
    "enrich_syncdomainslists": {
      "enabled": true,
      "interval": 30
    },
    "enrich_domainscategorization": {
      "enabled": true,
      "interval": 1,
      "ibm_basic_auth": "Basic ",
      "vt_api_key": ""
    }
  }
}
