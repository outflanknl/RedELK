# RedELK docker environment generated by Ansible
{% if redelk_version is not string or redelk_version is not match('^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$') or redelk_version in ['latest', 'master', 'main', 'develop', 'dev'] %}
{{ undef('redelk_version must be an explicit release tag, not a rolling branch or an environment expression.') | mandatory }}
{% endif %}
REDELKVERSION={{ redelk_version }}
REDELKREPO=outflanknl

COMPOSE_PROJECT_NAME={{ redelk_compose_project_name }}
LOG_MAX_SIZE={{ redelk_docker_log_max_size }}
LOG_MAX_FILE={{ redelk_docker_log_max_files }}

CERTS_DIR_ES=/usr/share/elasticsearch/config/certificates
CERTS_DIR_KBN=/usr/share/kibana/config/certificates
CERTS_DIR_LOGSTASH=/usr/share/logstash/config/certificates
CERTS_DIR_REDELK=/usr/share/logstash/redelk-main/certs


## Below you can configure the location to the certificates used in logstash
CERTS_LOGSTASH_INPUT_KEY=/usr/share/logstash/redelk-main/certs/elkserver.key
CERTS_LOGSTASH_INPUT_CRT=/usr/share/logstash/redelk-main/certs/elkserver.crt
CERTS_LOGSTASH_OUTPUT_CA=/usr/share/logstash/config/certificates/ca/ca.crt
CREDS_kibana_system={{ redelk_kibana_system_password }}
CREDS_logstash_system={{ redelk_logstash_system_password }}
CREDS_redelk_ingest={{ redelk_redelk_ingest_password }}
CREDS_redelk={{ redelk_redelk_password }}
ELASTIC_PASSWORD={{ redelk_elastic_password }}
ES_URL=https://redelk-elasticsearch:9200
KBN_XPACK_ENCRYPTEDSAVEDOBJECTS={{ redelk_kibana_encryption_key }}

NEO4J_AUTH=neo4j/{{ redelk_server_neo4j_password }}
NEO4J_dbms_memory_heap_initial__size={{ redelk_server_neo4j_memory | default('1G') }}
NEO4J_dbms_memory_heap_max__size={{ redelk_server_neo4j_memory | default('1G') }}
NEO4J_dbms_memory_pagecache_size={{ redelk_server_neo4j_memory | default('1G') }}
NEO4J_ALLOW_UPGRADE=true
BLOODHOUND_TAG=latest
# Postgres auth configuration
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD={{ redelk_postgres_password }}
POSTGRES_DATABASE=bloodhound
BLOODHOUND_PORT=127.0.0.1:8080
NEO4J_DB_PORT=7687
NEO4J_WEB_PORT=7474

CERTS_DIR_NGINX=/etc/nginx/certs
CERTS_DIR_NGINX_LOCAL=./mounts/certbot/conf
CERTS_DIR_NGINX_CA=/etc/nginx/ca_certs
CERTS_DIR_NGINX_CA_LOCAL=./mounts/certs/ca
TLS_NGINX_CRT_PATH=/etc/nginx/certs/live/{{ redelk_server_env_external_domain }}/fullchain.pem
TLS_NGINX_KEY_PATH=/etc/nginx/certs/live/{{ redelk_server_env_external_domain }}/privkey.pem
TLS_NGINX_CA_PATH=/etc/nginx/ca_certs/ca.crt

EXTERNAL_DOMAIN={{ redelk_server_env_external_domain }}
LE_EMAIL={{ redelk_server_env_le_email }}
